# Process maps. Copy to .env for local work; set real values in the Netlify UI
# for a deployed site. Never commit a filled-in copy.

# Postgres. On Netlify you do not set this: Netlify DB provisions the database
# and provides NETLIFY_DATABASE_URL. Set DATABASE_URL only for local work or CI.
DATABASE_URL=

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The first admin. While both are set, this address is an admin whose password
# is this value. Sign in, add the team on the Team page, then remove
# ADMIN_BOOTSTRAP_PASSWORD so the password is owned from the app.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
